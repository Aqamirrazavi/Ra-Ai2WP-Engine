# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# RTW_BRIDGE_KEY: 256-bit symmetric encryption key for WordPress token encryption (AES-256-CBC)
RTW_BRIDGE_KEY=example_rtw_bridge_aes256_secret_key_32chars_min

# SIGNING_KEY: Base64-encoded Keystore string for Android build release
SIGNING_KEY=placeholder_signing_key

# RELEASE_SIGNING_PASSPHRASE: Passphrase for multi-platform release artifacts
RELEASE_SIGNING_PASSPHRASE=placeholder_release_passphrase

# GH_TOKEN: GitHub Personal Access Token for repository dispatch
GH_TOKEN=ghp_example_github_token_here

# NPM_TOKEN: Token for automated npm registry deployment
NPM_TOKEN=npm_example_token_here
